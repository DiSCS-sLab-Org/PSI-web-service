# Host port exposed on VM
PSI_HOST_PORT=<host-port>

# App runtime inside container
PSI_HOST=<bind-host>
PSI_PORT=<app-port>

# Data paths inside container
PSI_DB_PATH=<db-path-inside-container>
SERVER_SET_PATH=<server-set-path-inside-container>

# PSI behavior
PSI_CONTAINER=<raw|gcs|bloom>
PSI_FPR=<false-positive-rate>
PSI_REVEAL=<elements|size>
